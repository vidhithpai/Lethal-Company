# ─── Stage 1: Build React app ─────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Install deps (cached layer — only re-runs when package files change)
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --prefer-offline

# Copy source
COPY frontend/index.html frontend/vite.config.js ./
COPY frontend/src/ ./src/
COPY frontend/public/ ./public/

# VITE_API_URL is set at build time so the browser knows where to call the API.
# Default: localhost:8002 (browser → host-exposed port on any machine)
ARG VITE_API_URL=http://localhost:8002
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# ─── Stage 2: Serve with nginx ────────────────────────────────────────────────
FROM nginx:1.27-alpine

# Copy built static files
COPY --from=builder /app/dist /usr/share/nginx/html

# SPA routing config: all routes fall back to index.html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

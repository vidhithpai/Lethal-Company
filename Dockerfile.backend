# ─── Stage 1: Python backend ─────────────────────────────────────────────────
FROM python:3.11-slim

# System deps for git (needed by git_history.py)
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies first (cached layer)
COPY requirements.txt .
RUN pip install --no-cache-dir --default-timeout=1000 torch --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir --default-timeout=1000 -r requirements.txt

# Copy source
COPY main.py .
COPY backend/ ./backend/
COPY demo_project/ ./demo_project/
COPY sample_project/ ./sample_project/

# Never run as root inside containers
RUN useradd -m appuser && chown -R appuser /app
USER appuser

EXPOSE 8001

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001"]

{
  "name": "vulngraph",
  "displayName": "VulnGraph Security Analyzer",
  "description": "Real-time ENTRY/SINK/GUARD detection with local analysis",
  "version": "0.1.0",
  "publisher": "vulngraph-dev",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Security",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:java"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vulngraph.analyzeFile",
        "title": "VulnGraph: Analyze Current File"
      },
      {
        "command": "vulngraph.analyzeWorkspace",
        "title": "VulnGraph: Analyze Workspace"
      }
    ],
    "configuration": {
      "title": "VulnGraph",
      "properties": {
        "vulngraph.backendUrl": {
          "type": "string",
          "default": "http://localhost:8002",
          "description": "VulnGraph backend URL (default: http://localhost:8002)"
        },
        "vulngraph.projectPath": {
          "type": "string",
          "default": "",
          "description": "Optional path visible to the backend for scanning. Use a container path such as /app/demo_project when the backend runs in Docker; leave empty when it runs locally."
        },
        "vulngraph.analyzeOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically re-analyze on file save (debounced 1500ms)"
        }
      }
    }
  }
}

{
  "name": "vulngraph",
  "displayName": "VulnGraph Security Analyzer",
  "description": "Real-time ENTRY/SINK/GUARD detection with local analysis",
  "version": "0.1.5",
  "publisher": "vulngraph-dev",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node -e \"console.log('Compiling VulnGraph extension...')\""
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Security",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:java",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vulngraph.analyzeFile",
        "title": "VulnGraph: Analyze Current File"
      },
      {
        "command": "vulngraph.analyzeWorkspace",
        "title": "VulnGraph: Analyze Workspace"
      }
    ],
    "configuration": {
      "title": "VulnGraph",
      "properties": {
        "vulngraph.backendUrl": {
          "type": "string",
          "default": "http://localhost:8001",
          "description": "VulnGraph backend URL (default: http://localhost:8001)"
        },
        "vulngraph.analyzeOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically re-analyze on file save (debounced 1500ms)"
        }
      }
    }
  }
}
